{
	"name": "litesvm",
	"version": "1.4.1",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist/"
	],
	"napi": {
		"binaryName": "litesvm",
		"targets": [
			"x86_64-apple-darwin",
			"x86_64-unknown-linux-gnu",
			"x86_64-unknown-linux-musl",
			"aarch64-apple-darwin",
			"aarch64-unknown-linux-gnu",
			"aarch64-unknown-linux-musl"
		]
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LiteSVM/litesvm.git"
	},
	"dependencies": {
		"@solana-program/system": "^0.14.0",
		"@solana-program/token": "^0.16.0",
		"@solana/kit": "^8.0.0"
	},
	"devDependencies": {
		"@napi-rs/cli": "^3.8.6",
		"@types/node": "22.20.1",
		"rome": "^12.1.3",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typedoc": "^0.28.20",
		"typedoc-plugin-markdown": "^4.12.0",
		"typedoc-vitepress-theme": "^1.1.3",
		"typescript": "^5.9.3",
		"vitepress": "^1.6.4"
	},
	"engines": {
		"node": ">= 20"
	},
	"scripts": {
		"artifacts": "napi artifacts",
		"build": "napi build --platform --release --output-dir litesvm --dts internal.d.ts --js internal.js",
		"build:debug": "napi build --platform litesvm --dts internal.d.ts --js internal.js",
		"prepublishOnly": "napi prepublish -t npm --no-gh-release",
		"fmt": "yarn fmt:rust && yarn fmt:js",
		"fmt:rust": "cargo fmt",
		"fmt:js": "rome format --write litesvm/index.ts tests/ tsconfig.json package.json",
		"lint": "yarn lint:rust && yarn lint:js",
		"lint:rust": "cargo clippy",
		"lint:js": "rome check litesvm/index.ts tests/ tsconfig.json package.json",
		"test": "node -r ts-node/register -r tsconfig-paths/register --max-old-space-size=4096 --test --test-concurrency=1 tests/*.test.ts",
		"build:js": "tsc --build && cp litesvm/internal.d.ts dist/internal.d.ts",
		"universal": "napi universal",
		"cargoBump": "cargo set-version --package litesvm-node --bump",
		"bumpPatch": "yarn version patch && napi version && cargo tree",
		"bumpMinor": "yarn version minor && napi version && cargo tree",
		"bumpMajor": "yarn version major && napi version && cargo tree",
		"predocs": "typedoc",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs"
	},
	"packageManager": "yarn@4.10.3"
}
