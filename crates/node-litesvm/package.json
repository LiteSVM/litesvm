{
	"name": "litesvm",
	"version": "1.3.0",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist/"
	],
	"license": "MIT",
	"dependencies": {
		"@solana-program/system": "^0.12.2",
		"@solana-program/token": "^0.14.0",
		"litesvm-core": "workspace:^"
	},
	"peerDependencies": {
		"@solana/kit": ">=6.0.0"
	},
	"devDependencies": {
		"@algolia/client-search": "^5.55.0",
		"@solana/kit": "^6.10.0",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "22.19.21",
		"@types/node-fetch": "^2.6.13",
		"markdown-it": "^14.2.0",
		"markdown-it-include": "^2.0.0",
		"rome": "^12.1.3",
		"search-insights": "^2.17.3",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typedoc": "^0.28.19",
		"typedoc-plugin-markdown": "^4.12.0",
		"typedoc-vitepress-theme": "^1.1.3",
		"typescript": "^5.9.3",
		"vitepress": "^1.6.4",
		"ws": "^8.21.0"
	},
	"engines": {
		"node": ">= 20"
	},
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "yarn clean && tsc --build",
		"prepublishOnly": "yarn build",
		"fmt": "yarn fmt:js",
		"fmt:js": "rome format --write litesvm/index.ts tests/ tsconfig.json package.json",
		"lint": "yarn lint:js",
		"lint:js": "rome check litesvm/index.ts tests/ tsconfig.json package.json",
		"test": "node -r ts-node/register -r tsconfig-paths/register --max-old-space-size=4096 --test --test-concurrency=1 tests/*.test.ts",
		"build:js": "yarn build",
		"bumpPatch": "yarn version patch",
		"bumpMinor": "yarn version minor",
		"bumpMajor": "yarn version major",
		"predocs": "typedoc",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs"
	}
}
